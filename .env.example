# ===== 乡育心桥 · 环境变量模板 =====
# 复制为 .env 并填入真实值；.env 不纳入版本控制

# AI 大模型服务（服务端调用，前端不暴露）
AI_API_BASE=https://your-ai-endpoint/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL：优先选择能严格遵守 JSON mode（response_format: json_object）的模型。
# 实测 deepseek-v4-flash-0731 会无视该参数直接输出 markdown 散文，
# 代码已做容错解析 + 二次修复 + 降级，但换模型可恢复结构化输出质量。
# 详见 docs/技术文档.md 4.7.1
AI_MODEL=your-model-name

# 向量检索（RAG）
EMBEDDING_MODEL=bge-m3
VECTOR_STORE=chroma

# 服务端口
PORT=3000
